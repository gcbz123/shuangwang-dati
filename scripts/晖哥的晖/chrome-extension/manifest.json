{
  "manifest_version": 3,
  "name": "晖哥的助手",
  "version": "2.3",
  "description": "支持自动/手动双模式的考试辅助插件，支持局网考试和职教考试",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "晖哥的助手"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "page-world.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
